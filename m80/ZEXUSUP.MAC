; zexusup.mac - supplemental tests for undocumented Z80 opcodes
;
; zexall/zexdoc don't exercise the bugs below: real assemblers only ever
; emit a DD/FD prefix directly before an H/L-referencing opcode, so an
; exerciser built around well-formed instruction encodings never generates
; a "prefix coincidentally in front of an unrelated opcode" sequence. All
; four bugs here were found by tracing a genuine CP/M 2.2 PIP.COM binary,
; where such a sequence arises from ordinary timing-padding.
;
; Tests 1-4 and the final HALT test are targeted regressions for bugs found
; in ntvcm.  Tests 5-10 fill undocumented-opcode gaps in zexall/zexdoc and
; zexsup.  Undocumented flag bits whose values differ among Z80 variants are
; deliberately not checked.
;
; Bugs covered
;
;   1. DD/FD-prefixed opcodes that don't reference H, L, or (HL) were
;      entirely unimplemented and aborted the emulator. On real Z80
;      hardware the prefix has no effect on such an opcode's semantics -
;      only its own M1/prefix cycle is consumed. Test 1 covers this with
;      the exact real-world case that surfaced it: a timing-padded DEC D.
;
;   2. Two opcode-mask bugs in the already-implemented H/L-redirection
;      cases let them incorrectly also match opcodes that don't reference
;      H/L at all:
;        - the "ld r,(ix+d)" mask omitted bit 7, misinterpreting the
;          ALU-immediate opcodes (adi/aci/sui/sbi/ani/xri/ori/cpi) as
;          index-relative loads. Test 2 covers this with ADD A,n.
;        - the "math on ixh/ixl" mask omitted bit 2, misinterpreting
;          plain register B/C ALU forms (add a,b, add a,c, etc.) the same
;          way. Test 3 covers this with ADD A,B.
;
;   3. A dispatch-ordering bug: DD 76 (prefixed HALT) incidentally
;      satisfies the (corrected) "ld r,(ix+d)" mask by bit-pattern
;      coincidence and was silently misdecoded as a memory-corrupting
;      load instead of reaching the disclosed not-implemented path. Test
;      5 covers this.
;
; Test 4 (DD 64) is a regression guard, not a bug fix verification: on
; real hardware, prefixed 0x64 is the genuine, if undocumented,
; self-assignment LD IXH,IXH / LD IYH,IYH, and was already handled
; correctly by pre-existing register-substitution logic before this fix -
; nothing in the fix touches that code path. Test 4 just confirms the
; other changes didn't disturb it.
;
;        org     100h
;
start:
        ld      sp,stack
;
; ---- test 1: general "prefix wasted" fallback (FD 15 = DEC D) ----
;
        ld      de,msg1
        call    prstr
        ld      d,5
        db      0fdh,015h               ; FD 15: DEC D (prefix wasted)
        ld      a,d
        cp      4
        jr      nz,t1fail
        ld      de,msgpass
        call    prstr
        jr      t2
t1fail:
        ld      de,msgfail
        call    prstr
;
; ---- test 2: DD C6 xx (ADD A,n - alu-immediate, no H/L reference) ----
;
t2:
        ld      de,msg2
        call    prstr
        ld      a,010h
        db      0ddh,0c6h,005h          ; DD C6 05: ADD A,5 (prefix wasted)
        cp      015h
        jr      nz,t2fail
        ld      de,msgpass
        call    prstr
        jr      t3
t2fail:
        ld      de,msgfail
        call    prstr
;
; ---- test 3: DD 80 (ADD A,B - alu-register, no H/L reference) ----
;
t3:
        ld      de,msg3
        call    prstr
        ld      a,010h
        ld      b,007h
        db      0ddh,080h               ; DD 80: ADD A,B (prefix wasted)
        cp      017h
        jr      nz,t3fail
        ld      de,msgpass
        call    prstr
        jr      t4
t3fail:
        ld      de,msgfail
        call    prstr
;
; ---- test 4: DD 64 (LD IXH,IXH - genuinely H-referencing; regression guard) ----
;
t4:
        ld      de,msg4
        call    prstr
        ld      ix,01234h
        db      0ddh,064h               ; DD 64: LD IXH,IXH (M80 has no native
                                         ; mnemonic for this undocumented form)
        push    ix
        pop     bc
        ld      a,c
        cp      034h
        jr      nz,t4fail
        ld      a,b
        cp      012h
        jr      nz,t4fail
        ld      de,msgpass
        call    prstr
	        jp      t5
t4fail:
        ld      de,msgfail
        call    prstr
;
; ---- test 5: DD/FD CB d rotate/shift register-result forms ----
;
; zexall tests only the r=6 memory-only encodings.  Test all 128 encodings,
; including SLL and the undocumented r<>6 forms which also copy the result
; to B/C/D/E/H/L/A.
;
t5:
	ld	de,msg5
	call	gstart
	ld	a,0ddh
	ld	(curpre),a
t5pre:
	xor	a
	ld	(curop),a
t5op:
	call	setupxy
	ld	a,081h
	ld	(scratch),a
	ld	bc,01111h
	ld	de,02222h
	ld	hl,03333h
	ld	a,044h
	or	a			; all RL/RR cases use carry-in zero
	call	iutcb
	call	capture

	ld	a,(curop)
	rrca
	rrca
	rrca
	and	7
	ld	e,a
	ld	d,0
	ld	hl,shiftexp
	add	hl,de
	ld	a,(hl)
	ld	(expect),a
	ld	b,a
	ld	a,(scratch)
	cp	b
	call	nz,failcur

	ld	a,(curop)
	and	7
	cp	6
	jr	z,t5next
	add	a,a
	ld	e,a
	ld	d,0
	ld	hl,desttab
	add	hl,de
	ld	e,(hl)
	inc	hl
	ld	d,(hl)
	ld	a,(de)
	ld	hl,expect
	cp	(hl)
	call	nz,failcur
t5next:
	ld	a,(curop)
	cp	03fh
	jr	z,t5pre_done
	inc	a
	ld	(curop),a
	jr	t5op
t5pre_done:
	ld	a,(curpre)
	cp	0ddh
	jr	nz,t5done
	ld	a,0fdh
	ld	(curpre),a
	jr	t5pre
t5done:
	call	gend

; ---- test 6: DD/FD CB d BIT opcode aliases ----
;
; For indexed BIT, the low three opcode bits are ignored.  zexall uses only
; r=6; exercise all eight encodings and require no register result.
;
	ld	de,msg6
	call	gstart
	ld	a,0ddh
	ld	(curpre),a
t6pre:
	ld	a,040h
	ld	(curop),a
t6op:
	call	setupxy
	xor	a
	ld	(scratch),a
	ld	bc,01111h
	ld	de,02222h
	ld	hl,03333h
	ld	a,044h
	or	a
	call	iutcb
	push	af
	call	capture
	pop	hl
	ld	a,l
	and	040h			; BIT of zero must set Z
	call	z,failcur
	ld	a,(scratch)
	or	a
	call	nz,failcur
	call	checkregs
	ld	a,(curop)
	cp	07fh
	jr	z,t6pre_done
	inc	a
	ld	(curop),a
	jr	t6op
t6pre_done:
	ld	a,(curpre)
	cp	0ddh
	jr	nz,t6done
	ld	a,0fdh
	ld	(curpre),a
	jr	t6pre
t6done:
	call	gend

; ---- test 7: DD/FD CB d RES/SET register-result forms ----
;
	ld	de,msg7
	call	gstart
	ld	a,0ddh
	ld	(curpre),a
t7pre:
	ld	a,080h
	ld	(curop),a
t7op:
	call	setupxy
	ld	a,(curop)
	and	040h
	jr	z,t7res
	xor	a
	jr	t7init
t7res:
	ld	a,0ffh
t7init:
	ld	(scratch),a
	ld	bc,01111h
	ld	de,02222h
	ld	hl,03333h
	ld	a,044h
	or	a
	call	iutcb
	call	capture
	ld	a,(curop)
	sub	080h
	rrca
	rrca
	rrca
	and	00fh
	ld	e,a
	ld	d,0
	ld	hl,srsexp
	add	hl,de
	ld	a,(hl)
	ld	(expect),a
	ld	b,a
	ld	a,(scratch)
	cp	b
	call	nz,failcur
	ld	a,(curop)
	and	7
	cp	6
	jr	z,t7next
	add	a,a
	ld	e,a
	ld	d,0
	ld	hl,desttab
	add	hl,de
	ld	e,(hl)
	inc	hl
	ld	d,(hl)
	ld	a,(de)
	ld	hl,expect
	cp	(hl)
	call	nz,failcur
t7next:
	ld	a,(curop)
	cp	0ffh
	jr	z,t7pre_done
	inc	a
	ld	(curop),a
	jr	t7op
t7pre_done:
	ld	a,(curpre)
	cp	0ddh
	jr	nz,t7done
	ld	a,0fdh
	ld	(curpre),a
	jr	t7pre
t7done:
	call	gend

; ---- test 8: duplicate ED encodings ----
;
	ld	de,msg8
	call	gstart
	call	test_ed_aliases
	call	gend

; ---- test 9: undefined ED opcodes behave as two-byte NOPs ----
;
	ld	de,msg9
	call	gstart
	ld	a,000h
	ld	b,03fh
	call	edrange
	ld	a,077h
	ld	b,077h
	call	edrange
	ld	a,07fh
	ld	b,07fh
	call	edrange
	ld	a,080h
	ld	b,09fh
	call	edrange
	ld	a,0a4h
	ld	b,0a7h
	call	edrange
	ld	a,0ach
	ld	b,0afh
	call	edrange
	ld	a,0b4h
	ld	b,0b7h
	call	edrange
	ld	a,0bch
	ld	b,0ffh
	call	edrange
	call	gend

; ---- test 10: representative ignored/repeated prefix combinations ----
;
	ld	de,msg10
	call	gstart
	call	test_prefixes
	call	gend

; ---- test 11: DD 76 (prefixed HALT) dispatch-ordering ----
;
; Real hardware executes this as plain, undisturbed HALT; this emulator
; deliberately leaves it as a disclosed not-implemented limitation instead
; (see the fix's own comments in x80.cxx for why - stopping the emulator's
; instruction-fetch loop from inside z80_emulate has no signaling path back
; to the caller). The correctness property under test here is narrower:
; does it correctly and safely reach that not-implemented path, or does it
; silently misdecode as a memory write instead (the actual bug: it
; incidentally satisfies the same "ld r,(ix+d)" mask fixed in test 2,
; decoding as a write into (HL))?
;
; On a FIXED emulator, executing the DD 76 05 below makes the emulator
; print its own "not-implemented" diagnostic and exit - so nothing after
; that point ever runs. If you see "DID NOT ABORT" printed, the fix is
; NOT present or NOT working: the emulator silently ran the wrong
; instruction instead of safely stopping.
;
t11:
	        ld      de,msg11
        call    prstr
        ld      hl,sentinel
        ld      (hl),0aah
        db      0ddh,076h,005h          ; DD 76 05
	        ld      de,msg11bad
	        call    prstr
;
; ---- exit (only reached if test 11 did not halt/abort) ----
;
        jp      0000h
;
; prstr: print the $-terminated string pointed to by DE via BDOS fn 9.
;
prstr:
        ld      c,9
        call    5
        ret
;
msg1:      db   'test 1 (FD 15 DEC D, general prefix-wasted fallback): $'
msg2:      db   'test 2 (DD C6 ADD A,n alu-immediate mask): $'
msg3:      db   'test 3 (DD 80 ADD A,B alu-register mask): $'
msg4:      db   'test 4 (DD 64 LD IXH,IXH, regression guard): $'
; ------------------------------------------------------------------
; Common test machinery.
; ------------------------------------------------------------------
gstart:
	call	prstr
	xor	a
	ld	(groupfail),a
	ret

gend:
	ld	a,(groupfail)
	or	a
	ld	de,msgpass
	jp	z,prstr
	ld	de,msgfailat
	call	prstr
	ld	a,(firstfail)
	call	phex2
	ld	de,crlf
	jp	prstr

failcur:
	ld	a,(groupfail)
	or	a
	ret	nz
	inc	a
	ld	(groupfail),a
	ld	a,(curop)
	ld	(firstfail),a
	ret

setupxy:
	ld	a,(curpre)
	ld	(iutcb),a
	ld	a,(curop)
	ld	(iutcb+3),a
	ld	ix,05555h
	ld	iy,06666h
	ld	a,(curpre)
	cp	0ddh
	jr	nz,setiy
	ld	ix,scratch
	ret
setiy:
	ld	iy,scratch
	ret

capture:
	ld	(gotbc),bc
	ld	(gotde),de
	ld	(gothl),hl
	ld	(gota),a
	ret

checkregs:
	ld	hl,(gotbc)
	ld	de,01111h
	or	a
	sbc	hl,de
	call	nz,failcur
	ld	hl,(gotde)
	ld	de,02222h
	or	a
	sbc	hl,de
	call	nz,failcur
	ld	hl,(gothl)
	ld	de,03333h
	or	a
	sbc	hl,de
	call	nz,failcur
	ld	a,(gota)
	cp	044h
	call	nz,failcur
	ret

; A=start, B=end, inclusive.  Loop values live in memory because the
; instruction under test must leave every ordinary register untouched.
edrange:
	ld	(curop),a
	ld	a,b
	ld	(rangeend),a
edrlp:
	ld	a,(curop)
	ld	(ediut+1),a
	ld	bc,01111h
	ld	de,02222h
	ld	hl,03333h
	ld	ix,05555h
	ld	iy,06666h
	ld	a,044h
	or	a
	call	ediut
	call	capture
	call	checkregs
	ld	a,(curop)
	ld	hl,rangeend
	cp	(hl)
	ret	z
	inc	a
	ld	(curop),a
	jr	edrlp

test_ed_aliases:
; ED 63 / ED 6B duplicate LD (nn),HL / LD HL,(nn).
	ld	hl,01234h
	db	0edh,063h
	dw	edword
	ld	hl,(edword)
	ld	de,01234h
	or	a
	sbc	hl,de
	call	nz,failcur
	ld	hl,05678h
	ld	(edword),hl
	ld	hl,0
	db	0edh,06bh
	dw	edword
	ld	de,05678h
	or	a
	sbc	hl,de
	call	nz,failcur

; All six duplicate RETN opcodes must pop PC exactly like ED 45.
	ld	hl,retnops
	ld	b,6
talp:
	ld	a,(hl)
	inc	hl
	ld	(retiut+1),a
	ld	(curop),a
	push	hl
	push	bc
	call	retiut
	pop	bc
	pop	hl
	djnz	talp
	ret

test_prefixes:
; DD/FD must be ignored before EX DE,HL.
	ld	de,01111h
	ld	hl,02222h
	db	0ddh,0ebh
	ld	a,d
	cp	022h
	call	nz,failcur
	ld	a,h
	cp	011h
	call	nz,failcur
	ld	de,03333h
	ld	hl,04444h
	db	0fdh,0ebh
	ld	a,d
	cp	044h
	call	nz,failcur
	ld	a,h
	cp	033h
	call	nz,failcur

; DD/FD before ED is ignored.
	ld	a,1
	db	0ddh,0edh,044h		; NEG
	cp	0ffh
	call	nz,failcur
	ld	a,1
	db	0fdh,0edh,044h
	cp	0ffh
	call	nz,failcur

; Repeated/mixed prefixes: the last DD or FD selects the index register.
	ld	ix,01111h
	ld	iy,02222h
	db	0ddh,0ddh,021h,034h,012h
	push	ix
	pop	hl
	ld	de,01234h
	or	a
	sbc	hl,de
	call	nz,failcur
	db	0fdh,0fdh,021h,078h,056h
	push	iy
	pop	hl
	ld	de,05678h
	or	a
	sbc	hl,de
	call	nz,failcur
	db	0ddh,0fdh,021h,0bch,09ah
	push	iy
	pop	hl
	ld	de,09abch
	or	a
	sbc	hl,de
	call	nz,failcur
	db	0fdh,0ddh,021h,0f0h,0deh
	push	ix
	pop	hl
	ld	de,0def0h
	or	a
	sbc	hl,de
	call	nz,failcur
	ret

; Writable instruction slots.
iutcb:	db	0ddh,0cbh,0,0,0c9h
ediut:	db	0edh,0,0c9h
retiut:	db	0edh,045h,0c9h

; Result byte for each indexed rotate/shift group with input 81h and C=0.
shiftexp:	db	003h,0c0h,002h,040h,002h,0c0h,003h,040h
; RES 0..7 of FFh, followed by SET 0..7 of 00h.
srsexp:	db	0feh,0fdh,0fbh,0f7h,0efh,0dfh,0bfh,07fh
	db	001h,002h,004h,008h,010h,020h,040h,080h
desttab:	dw	gotbc+1,gotbc,gotde+1,gotde,gothl+1,gothl,0,gota
retnops:	db	055h,05dh,065h,06dh,075h,07dh

curpre:	ds	1
curop:	ds	1
rangeend:	ds	1
groupfail:	ds	1
firstfail:	ds	1
expect:	ds	1
gota:	ds	1
gotbc:	ds	2
gotde:	ds	2
gothl:	ds	2
edword:	ds	2
scratch:	ds	1

phex2:
	push	af
	rrca
	rrca
	rrca
	rrca
	call	hexdig
	pop	af
hexdig:
	and	0fh
	add	a,'0'
	cp	'9'+1
	jr	c,hexout
	add	a,7
hexout:
	ld	e,a
	ld	c,2
	jp	5

msg5:      db   'test 5 (DD/FD CB rotate/shift register results): $'
msg6:      db   'test 6 (DD/FD CB BIT aliases): $'
msg7:      db   'test 7 (DD/FD CB RES/SET register results): $'
msg8:      db   'test 8 (duplicate ED LD/RETN encodings): $'
msg9:      db   'test 9 (undefined ED opcodes): $'
msg10:     db   'test 10 (ignored/repeated prefixes): $'
msg11:     db   13,10,'test 11 (DD 76 dispatch order) - emulator should halt/abort now...',13,10,'$'
msg11bad:  db   'test 11: DID NOT ABORT - fix missing or broken!',13,10,'$'
msgfailat: db   'FAIL at opcode $'
crlf:      db   13,10,'$'
msgpass:   db   'PASS',13,10,'$'
msgfail:   db   'FAIL',13,10,'$'
;
        ds      64
stack:
sentinel:  ds   1
;
        end     start


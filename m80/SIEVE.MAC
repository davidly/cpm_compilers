; Z80 version of BYTE's sieve
; replicate this:
;        #define TRUE 1
;        #define FALSE 0
;        #define SIZE 8190
;        
;        char flags[SIZE+1];
;        
;        int main()
;                {
;                int i,k;
;                int prime,count,iter;
;        
;                for (iter = 1; iter <= 10; iter++) {    /* do program 10 times */
;                        count = 0;                      /* initialize prime counter */
;                        for (i = 0; i <= SIZE; i++)     /* set all flags true */
;                                flags[i] = TRUE;
;                        for (i = 0; i <= SIZE; i++) {
;                                if (flags[i]) {         /* found a prime */
;                                        prime = i + i + 3;      /* twice index + 3 */
;                                        for (k = i + prime; k <= SIZE; k += prime)
;                                                flags[k] = FALSE;       /* kill all multiples */
;                                        count++;                /* primes found */
;                                        }
;                                }
;                        }
;                printf("%d primes.\n",count);           /*primes found in 10th pass */
;                return 0;
;                }
;

; cp/m-specific constants

BDOS            equ 5
BdosDisplayChar equ 2         ; c register function to print a character
BdosPrintString equ 9         ; c register function to print a $ terminated string

; app constants

true   equ 1
false  equ 0
loops  equ 10
size   equ 8190

sizehi equ size SHR 8
sizelo equ size AND 0ffh

sizep1hi equ ( size + 1 ) SHR 8
sizep1lo equ ( size + 1 ) AND 0ffh

  aseg
org     100h
        jp         actualcode       ; put data before code to satisfy the m80 assembler, which can't resolve the symbols otherwise

        PKFLAGS:    dw      0               ; address of flags[ k ]
        ITER:       dw      0               ; iter in C code
        SaveSP:     dw      0               ; temporarily save SP here

        NEGF:       db      0               ; Space for negative flag
                    db      '-00000'            
        NUM:        db      '$'             ; Space for number. cp/m strings end with a dollar sign
        CRLF:       db      13,10,0
        STRPRIMES:  db     ' primes.', 13, 10, 0
        
actualcode:
  iteragain:                        ; for ( iter = 1; iter <= 10; iter++ )
        ld         ix, 0            ; count = 0, kept in ix

        ; set all array entries to true:  for (i = 0; i <= SIZE; i++) flags[i] = TRUE;

        ld         hl, 0
        add        hl, sp
        ld         (SaveSP), hl
        ld         hl, flags + size + 2
        ld         sp, hl
        ld         hl, 0101h
        ld         bc, 0002h
  fillagain:
        push       hl
        push       hl
        push       hl
        push       hl
        push       hl
        push       hl
        push       hl
        push       hl
        dec        b
        jp         nz, fillagain
        dec        c
        jp         nz, fillagain
        ld         hl, (SaveSP)
        ld         sp, hl
        ld         hl, flags + size + 2   ; one guaranteed-true sentinel byte just past
        ld         (hl), 1                 ; the array proper; kloop can never reach or clear it

        ; iterate through array entries and count primes
        ; register usage:
        ;    hl:    scan pointer, then & flags[ k ]
        ;    de:    prime
        ;    a:     1 for cpir; the flags page limit 22h in kloop
        ;    bc:    cpir count (the sentinel always stops the scan first)
        ;    c:     0 in kloop, stored to clear flags
        ;    ix:    count

        ld         hl, flags

  nextprime:
        ld         a, true
        ld         bc, 0            ; 65536: only the sentinel or a set flag stops cpir
        cpir                        ; find the next true flag; hl is one past it
        dec        hl               ; hl = & flags[ i ]
        ld         a, HIGH afterflags   ; the guaranteed-true sentinel just past the array?
        cp         h
        jp         z, checknextiter
        inc        hl
        push       hl               ; resume the scan just past flags[ i ]

        ld         d, h             ; prime = i + i + 3 = 2 * ( &flags[ i ] + 1 ) - 2 * flags + 1
        ld         e, l
        ex         de, hl
        add        hl, hl
        ld         bc, 1 - 2 * flags
        add        hl, bc
        ex         de, hl           ; de is prime, hl = & flags[ i ] + 1
        dec        hl
        ld         c, 0             ; stored by kloop to clear flags
        add        hl, de           ; hl = & flags[ k ], k = i + prime

        ; Primes below 256 make most of the marks. For them, b is the high
        ; byte of 22ffh - 7 * prime: while h < b, eight more marks stay in bounds.
        ld         a, d
        or         a
        jp         nz, kcheck
        push       hl
        ld         h, d             ; hl = 7 * prime = 8 * prime - prime
        ld         l, e
        add        hl, hl
        add        hl, hl
        add        hl, hl
        sbc        hl, de           ; carry is clear: no carry from these small doublings
        ld         a, 22h           ; high( 22ffh - 7 * prime ): the low byte never borrows
        sub        h
        ld         b, a
        pop        hl
        ld         a, h
        cp         b
        jp         nc, kcheck

  k8loop:                           ; eight marks per bounds check
        ld         (hl), c
        add        hl, de
        ld         (hl), c
        add        hl, de
        ld         (hl), c
        add        hl, de
        ld         (hl), c
        add        hl, de
        ld         (hl), c
        add        hl, de
        ld         (hl), c
        add        hl, de
        ld         (hl), c
        add        hl, de
        ld         (hl), c
        add        hl, de
        ld         a, h
        cp         b
        jp         c, k8loop

  kcheck:
        ld         a, 22h           ; flags goes from 0x0300 to 0x22ff. 0x2300 means we're past the array
        cp         h
        jp         c, inccount

  kloop:                            ; hl = pointer to k'th element in flags. de = prime
        ld         (hl), c          ; flags[ k ] = false
        add        hl, de           ; k += prime
        cp         h
        jp         nc, kloop

  inccount:
        inc        ix               ; count++
        pop        hl
        jp         nextprime

  checknextiter:                    ; are we done iterating loops times?
        ld         a, (ITER)
        inc        a
        ld         (ITER), a
        cp         loops
        jp         nz, iteragain

        push       ix               ; print the count of primes and the string
        pop        hl
        call       PrintUnsigned
        ld         hl, STRPRIMES
        call       DisplayString

        ret                         ; return to CP/M

DisplayOneCharacter:                ; display the character in a
        push    bc
        push    de
        push    hl

        ld      c, BdosDisplayChar
        ld      e, a
        call    BDOS

        pop     hl
        pop     de
        pop     bc
        ret

DisplayString:                      ; display null-terminated string pointed to by hl
        push    hl
        push    de
        push    bc

        ld      b, h
        ld      c, l

  DSNext:
        ld      a, (bc)
        cp      0
        jp      z, DSDone
        call    DisplayOneCharacter
        inc     bc
        jp      DSNext

  DSDone:
        pop     bc
        pop     de
        pop     hl
        ret

PrintUnsigned:                      ; print the unsigned 16-bit number in HL
        ld      de, NUM             ; Load pointer to end of number string
        push    de                  ; Onto the stack
        ld      bc, -10             ; Divide by ten (by trial subtraction)
  PU$DIGIT:
        ld      de, -1              ; DE = quotient. There is no 16-bit subtraction,
  PU$DGTDIV:
        add     hl, bc              ; so we just add a negative value,
        inc     de
        jp      c, PU$DGTDIV        ; while that overflows.
        ld      a, '0'+10           ; The loop runs once too much so we're 10 out
        add     a, l                ; The remainder (minus 10) is in L
        ex      (sp), hl            ; Swap HL with top of stack (i.e., the string pointer)
        dec     hl                  ; Go back one byte
        ld      (hl), a             ; And store the digit
        ex      (sp), hl            ; Put the pointer back on the stack
        ex      de, hl              ; Do all of this again with the quotient
        ld      a, h                ; If it is zero, we're done
        or      l
        jp      nz, PU$DIGIT        ; But if not, there are more digits
        ld      c, BdosPrintString  ; Prepare to call CP/M and print the string
        pop     de
        jp      bdos                ; And only then print the string. bdos will return to caller

        flags equ 2300h-8192
        afterflags equ flags+size+2
;org 2300h-8192
;        flags:      ds      size + 1
;        afterflags: db      69h             ; make it easy to find. will be 1 after initialization to terminate cpir

end


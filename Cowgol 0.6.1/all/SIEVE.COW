const SIZE := 8191;

sub sieve()
    var flags: int8[ SIZE ];
    var iter: uint8;
    var i: uint16;
    var k: uint16;
    var prime: uint16;
    var count: uint16;

    iter := 0;
    while iter < 10 loop
        i := 0;
        while i < SIZE loop
           flags[ i ] := 1;
           i := i + 1;
        end loop;
        
        count := 0;
        i := 0;
        while i < SIZE loop
            if flags[ i ] == 1 then
                prime := i + i + 3;
                k := i + prime;
                while k < SIZE loop
                    flags[ k ] := 0;
                    k := k + prime;
                end loop;
                count := count + 1;
            end if;
            i := i + 1;
        end loop;
        iter := iter + 1;
    end loop;
    
    print( "count: " );
    print_i16( count );
    print( "\n" );
end sub;

sieve();

    

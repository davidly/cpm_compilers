/* SIEVE.SRC FROM ../SYSTEMS CONSULTANTS PLMX V23, PORTED TO INTEL
   PL/M-80 4.1: BDOS CALLS GO THROUGH MON1, STRINGS ARE INITIAL ARRAYS
   (DECLARED BEFORE LARGE ARRAYS TO AVOID PLM82 ERROR 102), OUTPUT IS
   UPPERCASE, AND PRT$NUM PRINTS 0 CORRECTLY. */
100H:
MON1: PROCEDURE(F,A);
    DECLARE F BYTE, A ADDRESS;
    GO TO 5;
END MON1;

WR$CON: PROCEDURE(CHAR);
    DECLARE CHAR BYTE;
    CALL MON1(2, CHAR);
END WR$CON;

PRT$DOLLAR: PROCEDURE(ADRS);
    DECLARE ADRS ADDRESS;
    CALL MON1(9, ADRS);
END PRT$DOLLAR;

PRT$CRLF: PROCEDURE;
    CALL WR$CON(13);
    CALL WR$CON(10);
END PRT$CRLF;

PRT$NUM: PROCEDURE(N);
    DECLARE N ADDRESS;
    DECLARE S(5) BYTE INITIAL(' ', ' ', ' ', ' ', '0');
    DECLARE (I,J) BYTE;
    I = 4;
    DO WHILE N > 0;
        J = N MOD 10 + '0';
        N = N / 10;
        S(I) = J;
        I = I - 1;
    END;
    DO I = 0 TO 4;
        IF S(I) <> ' ' THEN DO;
            CALL WR$CON(S(I));
            S(I) = ' ';
        END;
    END;
    S(4) = '0'; /* PLMX'S VERSION LEFT IT BLANK, SO 0 PRINTED NOTHING */
END PRT$NUM;

DECLARE TITLE(22) BYTE INITIAL('SIEVE 10 ITERATIONS', 13, 10, '$');
DECLARE COUNTMSG(8) BYTE INITIAL('COUNT: ', '$');
DECLARE PRIME$MAX LITERALLY '8190';
DECLARE PRIME(8191) BYTE;

RUN$SIEVE: PROCEDURE(SIZE);
    DECLARE (SIZE, P, K, I, L, COUNT) ADDRESS;

    CALL PRT$DOLLAR(.TITLE);
    DO L = 1 TO 10;
        COUNT = 0;
        DO I = 0 TO SIZE;
            PRIME(I) = 1;
        END;

        DO I = 0 TO SIZE - 1;
            IF PRIME(I) THEN DO;
                P = I + I + 3;
                DO K = I + P TO SIZE - 1 BY P;
                    PRIME(K) = 0;
                END;
                COUNT = COUNT + 1;
            END;
        END;
    END;

    CALL PRT$DOLLAR(.COUNTMSG);
    CALL PRT$NUM(COUNT);
    CALL PRT$CRLF;
END RUN$SIEVE;

CALL RUN$SIEVE(PRIME$MAX);
CALL MON1(0, 0);
